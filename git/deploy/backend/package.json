{
  "name": "railflow-backend",
  "version": "2.0.0",
  "description": "RailFlow — Smart Railway Intelligence REST API powered by Node.js, Express & SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node database/init.js",
    "db:import": "node ../scripts/import-csv.js",
    "db:validate": "node ../scripts/validate-data.js",
    "test": "node --test ../tests/api.test.js ../tests/db.test.js ../tests/pnr.test.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["railflow", "railway", "indian-railways", "express", "sqlite", "rest-api"],
  "license": "MIT",
  "private": true
}
